{
  "manifest_version": 3,
  "name": "Copy bình luận Facebook",
  "version": "0.1.0",
  "description": "Sao chép bình luận và phản hồi từ bài viết Facebook đang mở.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Copy bình luận Facebook",
    "default_popup": "popup.html"
  }
}
